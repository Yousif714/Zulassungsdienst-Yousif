# Supabase-Projekt-URL (Projekteinstellungen → API)
SUPABASE_URL=
# Service-Role-Schlüssel von Supabase, nur auf dem Server verwenden, nie im Browser
SUPABASE_SERVICE_ROLE_KEY=
# Geheimnis zum Signieren der Sitzungs-Cookies, mindestens 32 Zeichen
SESSION_SECRET=
# Einmaliger Einrichtungscode für den ersten Passkey des Inhabers
OWNER_SETUP_TOKEN=
# Geheimnis, mit dem sich der Cron-Aufruf ausweist
CRON_SECRET=
# Öffentliche Adresse der App, z. B. https://nexus.example.de (für Passkeys und Herkunftsprüfung)
APP_ORIGIN=
