# Supabase-Projekt-URL (Projekteinstellungen → API)
SUPABASE_URL=
# Service-Role-Schlüssel von Supabase, nur auf dem Server verwenden, nie im Browser
SUPABASE_SERVICE_ROLE_KEY=
# Geheimnis zum Signieren der Sitzungs-Cookies, mindestens 32 Zeichen
SESSION_SECRET=
# Einmaliger Einrichtungscode für den ersten Passkey des Inhabers
OWNER_SETUP_TOKEN=
# Geheimnis, mit dem sich der Cron-Aufruf ausweist
CRON_SECRET=
# Öffentliche Adresse der App, z. B. https://nexus.example.de (für Passkeys und Herkunftsprüfung)
APP_ORIGIN=
# Paket 2b (optional, nur Production): Stripe Restricted Key, nur lesend
STRIPE_RESTRICTED_KEY=
# Paket 2b (optional): Signing Secret des Stripe-Webhooks (whsec_…)
STRIPE_WEBHOOK_SECRET=
# Paket 2b (optional): Lexware-API-Schlüssel des Kontos NEXUS
LEXWARE_NEXUS_API_KEY=
# Paket 2b (optional): Lexware-API-Schlüssel des Kontos Zulassung
LEXWARE_ZULASSUNG_API_KEY=
